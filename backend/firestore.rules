rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sauvegarde privée ChessQuest. Chaque joueur ne peut lire et modifier que
    // son propre document Firebase Auth (progression, boutique et cache des
    // dernières parties Chess.com).
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Annuaire minimal pour trouver un ami par son pseudo ChessQuest. Aucun
    // progrès ni information privée n'est exposé ici.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Invitations privées : elles alimentent la cloche du joueur invité.
    match /invitations/{inviteId} {
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string;
      allow read: if request.auth != null
        && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow update: if request.auth != null
        && ((resource.data.senderUid == request.auth.uid && request.resource.data.status == 'cancelled')
          || (resource.data.recipientUid == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined']));
      allow delete: if false;
    }

    // Liste des pseudos Chess.com à surveiller. N'importe qui peut
    // s'ajouter (pas d'authentification dans ce projet), mais seuls
    // les champs attendus sont acceptés — pas de quoi faire de dégâts,
    // au pire quelqu'un ajoute un pseudo public en trop.
    match /users/{username} {
      allow read: if true;
      allow create, update: if username.matches('^[a-z0-9_-]{2,25}$')
                   && request.resource.data.keys().hasOnly(['username', 'addedAt'])
                   && request.resource.data.username == username
                   && request.resource.data.addedAt is string
                   && request.resource.data.addedAt.size() <= 40;
      allow delete: if false;
    }

    // Parties précalculées (par le job GitHub Actions) OU sauvegardées par l'app
    // elle-même juste après une analyse en direct (repli quand le job n'est pas
    // encore passé). Lecture libre. Écriture autorisée uniquement en création —
    // une partie déjà analysée ne peut jamais être réécrite depuis le navigateur.
    match /games/{gameId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['gameId', 'pgn', 'results'])
                    && request.resource.data.keys().hasOnly(['gameId', 'username', 'url', 'white', 'black', 'end_time', 'pgn', 'headers', 'results', 'analyzedAt', 'source'])
                    && request.resource.data.gameId == gameId
                    && gameId.size() <= 60
                    && request.resource.data.pgn is string
                    && request.resource.data.pgn.size() <= 50000
                    && request.resource.data.results is list
                    && request.resource.data.results.size() <= 700;
      allow update: if false;
      allow delete: if false;
    }

    // Parties amicales ChessQuest : le lien d'invitation permet au second
    // joueur de rejoindre, puis seuls les deux participants voient/modifient
    // la partie et son chat.
    match /matches/{matchId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.participantIds.size() == 1
        && request.resource.data.participantIds.hasAny([request.auth.uid]);
      // Un défi encore en attente peut être lu par le détenteur du lien afin
      // qu'il puisse rejoindre la partie ; dès qu'il est actif il redevient privé.
      allow read: if request.auth != null
        && (resource.data.status == 'waiting'
            || resource.data.participantIds.hasAny([request.auth.uid]));
      allow update: if request.auth != null
        && request.resource.data.participantIds.size() <= 2
        && (resource.data.participantIds.hasAny([request.auth.uid])
            || request.resource.data.participantIds.hasAny([request.auth.uid]));
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/matches/$(matchId)).data.participantIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/matches/$(matchId)).data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 160;
        allow update, delete: if false;
      }
    }
  }
}
