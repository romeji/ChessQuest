rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Liste des pseudos Chess.com à surveiller. N'importe qui peut
    // s'ajouter (pas d'authentification dans ce projet), mais seuls
    // les champs attendus sont acceptés — pas de quoi faire de dégâts,
    // au pire quelqu'un ajoute un pseudo public en trop.
    match /users/{username} {
      allow read: if true;
      allow create, update: if username.matches('^[a-z0-9_-]{2,25}$')
                   && request.resource.data.keys().hasOnly(['username', 'addedAt'])
                   && request.resource.data.username == username
                   && request.resource.data.addedAt is string
                   && request.resource.data.addedAt.size() <= 40;
      allow delete: if false;
    }

    // Parties précalculées (par le job GitHub Actions) OU sauvegardées par l'app
    // elle-même juste après une analyse en direct (repli quand le job n'est pas
    // encore passé). Lecture libre. Écriture autorisée uniquement en création —
    // une partie déjà analysée ne peut jamais être réécrite depuis le navigateur.
    match /games/{gameId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['gameId', 'pgn', 'results'])
                    && request.resource.data.keys().hasOnly(['gameId', 'username', 'url', 'white', 'black', 'end_time', 'pgn', 'headers', 'results', 'analyzedAt', 'source'])
                    && request.resource.data.gameId == gameId
                    && gameId.size() <= 60
                    && request.resource.data.pgn is string
                    && request.resource.data.pgn.size() <= 50000
                    && request.resource.data.results is list
                    && request.resource.data.results.size() <= 700;
      allow update: if false;
      allow delete: if false;
    }
  }
}
